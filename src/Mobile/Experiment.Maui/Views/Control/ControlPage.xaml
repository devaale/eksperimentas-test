<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 x:Class="Experiment.Maui.Views.Control.ControlPage"
			 xmlns:VM="clr-namespace:Experiment.Maui.ViewModels.Control"
			Title="{Binding Title}">
    <ContentPage.BindingContext>
        <VM:ControlViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Content>
        <StackLayout Padding="10" Spacing="15">

            <Button x:Name="CmdGroups" 
				Text="{Binding LabelGroups}"   
				Command="{Binding GroupsListCommand}"/>

            <Button x:Name="CmdAlgorithms" 
				Text="{Binding LabelAlgorithms}"   
				Command="{Binding AlgorithmsListCommand}"/>
            
        </StackLayout>

    </ContentPage.Content>
</ContentPage>
