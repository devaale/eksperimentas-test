<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			x:Class="Experiment.Maui.Views.Main.MainPage"
			xmlns:V="clr-namespace:Experiment.Maui.Views.Main"
			xmlns:VM="clr-namespace:Experiment.Maui.ViewModels.Main"
			Title="{Binding Title}">

	<TabbedPage.BindingContext>
		<VM:MainViewModel />
	</TabbedPage.BindingContext>

	<TabbedPage.Resources>
		<!--
		<Style TargetType="StackLayout">
			<Setter Property="Margin" Value="32" />
		</Style>
		-->
	</TabbedPage.Resources>

	<TabbedPage.Children>
		<V:DashboardPage />
		<V:MainMenuPage />
	</TabbedPage.Children>

</TabbedPage>
