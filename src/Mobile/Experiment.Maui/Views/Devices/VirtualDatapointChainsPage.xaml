<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Experiment.Maui.Views.Devices.VirtualDatapointChainsPage"
			 xmlns:CV="clr-namespace:Experiment.Maui.Data.Converters">

	<ContentPage.Resources>
		<ResourceDictionary>
			<CV:DecimalToStringConverter x:Key="Dec2Str" />
		</ResourceDictionary>
	</ContentPage.Resources>

    <ContentPage.Content>

        <StackLayout Margin="0">

			<ListView x:Name="LvwItems"
				ItemsSource="{Binding Chains, Mode=OneWay}"
				SelectedItem="{Binding SelectedChain}"
				HasUnevenRows="True"
				VerticalOptions="FillAndExpand"
				SelectionMode="None">

				<ListView.ItemTemplate>
					<DataTemplate>
						<ViewCell>
							<ViewCell.View>
									<Grid ColumnSpacing="0" RowSpacing="0" Margin="0,6,0,6" Padding="0">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>

									<Entry Grid.Column="0"
									   Placeholder="{Binding ExpectedDataPointName, TargetNullValue='Value'}"
										Text="{Binding Value, FallbackValue=null, Converter={StaticResource Dec2Str}}" />

								<Button Grid.Column="1"
									Text="{Binding RelatedDatapointPickDisplayText}"
									Clicked="OnPickRelatedDatapoint"
									LineBreakMode="TailTruncation"
									Padding="8,6"
									BorderWidth="0"
									BorderColor="Transparent"
									TextColor="{StaticResource Foreground1}"
									BackgroundColor="{StaticResource Background4}" />

									</Grid>
							</ViewCell.View>
						</ViewCell>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>

			<Grid IsVisible="{Binding SelectedFormula.HasDynamicChains, FallbackValue=false}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0"
					Command="{Binding DeleteChainCommand}"
					Text="{Binding LabelDelete}"
					IsEnabled="{Binding HasMoreThanOneChain}"
					Style="{StaticResource negativeButton}" />

				<Button Grid.Column="1"
					Command="{Binding AddChainCommand}"
					Text="{Binding LabelAdd}" />

			</Grid>

		</StackLayout>
    </ContentPage.Content>
</ContentPage>
