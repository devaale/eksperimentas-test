<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
			 xmlns:UIC="clr-namespace:Experiment.Maui.UI.Controls"
			 xmlns:data="clr-namespace:Experiment.Maui.Data"
			 xmlns:M="clr-namespace:Experiment.Maui.Models"
			 xmlns:VM="clr-namespace:Experiment.Maui.ViewModels.Ecosystem"
			 x:Class="Experiment.Maui.Views.Ecosystem.ChatConversationsPage"
			 Title="{Binding Title}">

	<ContentPage.BindingContext>
		<VM:ChatConversationsViewModel />
	</ContentPage.BindingContext>

	<ContentPage.Content>

		<!-- Main container with vertical orientation -->
		<StackLayout Orientation="Vertical" Spacing="8">

			<!-- Search line: Image + Entry -->
			<Grid ColumnDefinitions="Auto,*"
				  Margin="18,6">
				<Image Grid.Column="0"
					   Source="{x:Static data:Images.UrlZoomImg}"
					   HeightRequest="32"
					   Margin="6,2"
					   VerticalOptions="Center" />

				<Entry Grid.Column="1"
					   x:Name="TxtSearchText"
					   Placeholder="{Binding LabelSearchText}"
					   HorizontalOptions="FillAndExpand"
					   Text="{Binding SearchText}" />
			</Grid>

			<!-- Buttons: Search on left, Clear on right -->
			<Grid ColumnDefinitions="*,*"
				  ColumnSpacing="10"
				  Margin="18,0">
				<Button Grid.Column="0"
						x:Name="CmdSearch"
						Command="{Binding SearchCommand}"
						Text="{Binding LabelSearch}"
						HorizontalOptions="Start" />

				<Button Grid.Column="1"
						x:Name="CmdClear"
						Command="{Binding ClearCommand}"
						Text="{Binding LabelClear}"
						HorizontalOptions="End"
						Style="{StaticResource negativeButton}" />
			</Grid>

			<ListView x:Name="LvwItems"
					  ItemsSource="{Binding Items, Mode=OneWay}"
					  SelectedItem="{Binding SelectedItem}"
					  HasUnevenRows="True"
					  SelectionMode="Single"
					  IsPullToRefreshEnabled="True"
					  RefreshCommand="{Binding RefreshCommand}"
					  IsRefreshing="{Binding IsRefreshing}">

				<ListView.ItemTemplate>

					<DataTemplate>

						<ViewCell>
							<Grid BackgroundColor="{StaticResource Background8}"
								  Margin="2"
								  Padding="2"
								  HorizontalOptions="Fill">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<Label Grid.Column="0"
									   Grid.Row="0"
									   Text="{Binding Sender}"
									   FontSize="Medium"
									   FontAttributes="Bold"
									   BackgroundColor="{StaticResource Background8}" />

								<Label Grid.Column="0"
									   Grid.Row="1"
									   Text="{Binding Body}"
									   FontSize="Body"
									   LineBreakMode="TailTruncation"
									   BackgroundColor="{StaticResource Background8}" />

								<Image Grid.Column="1"
									   Grid.Row="0"
									   Source="{x:Static data:Images.UrlSettings}"
									   HeightRequest="24"
									   HorizontalOptions="End"
									   VerticalOptions="Start"
									   Margin="3">

									<!-- https://stackoverflow.com/a/65492475 -->
									<Image.Triggers>
										<DataTrigger TargetType="Image" Binding="{Binding HasUnread}" Value="True">
											<Setter Property="Source" Value="{x:Static data:Images.UrlAlarms}" />
										</DataTrigger>
									</Image.Triggers>
								</Image>

								<Label Grid.Column="1"
									   Grid.Row="1"
									   Text="{Binding Date}"
									   BackgroundColor="{StaticResource Background8}"
									   FontSize="Small"
									   HorizontalOptions="End"
									   VerticalOptions="End" />
							</Grid>
						</ViewCell>

					</DataTemplate>

				</ListView.ItemTemplate>

			</ListView>

			<ActivityIndicator IsVisible="{Binding IsBusy}"
							   IsRunning="{Binding IsBusy}" />
		</StackLayout>
	</ContentPage.Content>
</ContentPage>

