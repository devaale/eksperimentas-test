<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:VM="clr-namespace:Experiment.Maui.ViewModels.Settings"
			 x:Class="Experiment.Maui.Views.Settings.ObjectPage"
			 Title="{Binding Title}">

	<ContentPage.Content>

		<StackLayout Orientation="Vertical">

			<Label Text="{Binding LabelObjectInfo}"
				   FontAttributes="Bold"
				   IsEnabled="{Binding CanBeEdited}" />

			<Entry x:Name="LblDescription"
				   Placeholder="{Binding LabelDescription}"
				   Text="{Binding Item.Name}"
				   IsEnabled="{Binding CanBeEdited}" />

			<Button x:Name="CmdGiveTokens"
					Text="{Binding LabelGiveTokens}"
					Command="{Binding GiveTokenCommand}"
					IsEnabled="{Binding CanDonate}"
					Margin="0,0,0,10" />

			<Frame IsVisible="{Binding CanBeEdited}"
				   Margin="0"
				   Padding="0">

				<StackLayout Orientation="Vertical">

					<Label Text="{Binding LabelShareToFriends}"
						   FontAttributes="Bold"
						   IsEnabled="{Binding CanBeEdited}" />

					<ListView x:Name="LvwItems"
							  ItemsSource="{Binding FriendPermissions, Mode=OneWay}"
							  SelectedItem="{Binding SelectedFriendPermission, Mode=TwoWay}"
							  IsEnabled="{Binding CanBeEdited}">

						<ListView.ItemTemplate>
							<DataTemplate>

								<TextCell Text="{Binding Name}"
										  TextColor="{StaticResource Foreground1}"
										  Detail="{Binding Detail}"
										  DetailColor="{StaticResource Foreground3}" />

								<!--
								<ViewCell>
									
									<Grid>
										<CheckBox Grid.Column="0"
												  IsChecked="{Binding Selected}" />

										<Label Grid.Column="1"
											   Grid.Row="0"
											   Text="{Binding Name}"
											   FontAttributes="Bold"
											   Padding="10, 5"/>
									</Grid>
								</ViewCell>
								-->
							</DataTemplate>
						</ListView.ItemTemplate>

					</ListView>
				</StackLayout>
			</Frame>

			<StackLayout Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">

				<Button x:Name="CmdSave"
						Text="{Binding LabelSave}"
						HorizontalOptions="FillAndExpand"
						Command="{Binding SaveCommand}"
						IsEnabled="{Binding CanBeEdited}" />

				<Button x:Name="CmdDelete"
						Text="{Binding LabelDelete}"
						HorizontalOptions="FillAndExpand"
						Command="{Binding DeleteCommand}"
						IsEnabled="{Binding CanDelete}"
						Style="{StaticResource negativeButton}"/>

				<Button x:Name="CmdCancel"
						Style="{StaticResource actionButton}"
						Text="{Binding LabelCancel}"
						HorizontalOptions="FillAndExpand"
						Command="{Binding CancelCommand}" />

			</StackLayout>
		</StackLayout>
	</ContentPage.Content>
</ContentPage>
