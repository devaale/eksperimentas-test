<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:UIC="clr-namespace:Experiment.Maui.UI.Controls"
			 xmlns:vm="clr-namespace:Experiment.Maui.ViewModels.Graph"
			 x:Class="Experiment.Maui.Views.Graph.GraphDevicesSelectPage"
			 Title="{Binding Title}">
	
	<ContentPage.BindingContext>
		<vm:GraphDevicesSelectViewModel />
	</ContentPage.BindingContext>
	
    <ContentPage.Content>
		
        <StackLayout Orientation="Vertical">
			
			<ListView x:Name ="LvwList"
				IsGroupingEnabled="True"
				GroupDisplayBinding="{Binding GroupKey}"
				GroupShortNameBinding="{Binding GroupKey}"
				ItemsSource="{Binding Devices}">
				<ListView.GroupHeaderTemplate>
					<DataTemplate>
						<ViewCell>
							<ViewCell.View>
								<Label Text="{Binding GroupKey}"
									   FontAttributes="Bold"
									   TextColor="{StaticResource Foreground3}"
									   Padding="5" />
							</ViewCell.View>
						</ViewCell>
					</DataTemplate>
				</ListView.GroupHeaderTemplate>
				<ListView.ItemTemplate>
					<DataTemplate>
						<!--
						<SwitchCell Text="{Binding Name}"
									On="{Binding Selected}" />
						-->
						<ViewCell>
							<ViewCell.View>
								<UIC:ECheckBox Text="{Binding Name}"
											   IsChecked="{Binding Selected}" />
							</ViewCell.View>
						</ViewCell>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>

			<ActivityIndicator 
				IsVisible="{Binding IsBusy}"
				IsRunning="{Binding IsBusy}" />

			<Button x:Name="CmdNext"
				Text="{Binding LabelNext}" 
				Command="{Binding NextCommand}" />

		</StackLayout>
    </ContentPage.Content>
</ContentPage>
