<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Experiment.Maui.Views.Graph.DatapointValueListPage"
			 Title="{Binding Datapoint.Name}">
    <ContentPage.Content>
		<StackLayout>
			<ListView x:Name="LwvValues" 
						  ItemsSource="{Binding Datapoint.Values}"
						  BackgroundColor="{StaticResource Background1}"
						  SeparatorColor="{StaticResource Foreground3}">

				<ListView.ItemTemplate>
					<DataTemplate>
						<ViewCell>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<Label Grid.Column="0" 
										   Text="{Binding Date}"
										   FontAttributes="Bold" />

								<Label Grid.Column="1"
										   Text="{Binding Value}" />
							</Grid>
						</ViewCell>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
		</StackLayout>
    </ContentPage.Content>
</ContentPage>
