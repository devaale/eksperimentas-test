<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Experiment.Maui.Views.ForgotPasswordPage"
             xmlns:VM="clr-namespace:Experiment.Maui.ViewModels"
			 Title="{Binding Title}">
	<ContentPage.BindingContext>
		<VM:ForgotPasswordViewModel />
	</ContentPage.BindingContext>
    <ContentPage.Content>
        <StackLayout Margin="16" Padding="32">

			<Label Text="{Binding LabelEnterYourEmail}"
				HorizontalOptions="CenterAndExpand"
				FontSize="Large"
				HorizontalTextAlignment="Center" />

			<Entry x:Name="TxtEmailAddress"
				Placeholder="{Binding LabelEmail}"
				Text="{Binding Email}" />

			<Button x:Name="CmdSubmit"
				Text="{Binding LabelSubmit}"
				TextTransform="None"
				FontSize="Body"
				Command="{Binding ForgotPasswordCommand}"
				IsEnabled="{Binding CanBeSend}"/>

		</StackLayout>
    </ContentPage.Content>
</ContentPage>
